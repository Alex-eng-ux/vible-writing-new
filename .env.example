# ---- Application environment (safe placeholders; never real secrets) ----
# One of: development | evaluation | production
APP_ENV=development

# Single-user private deployment. V1 does not provide multi-user auth/tenancy.
DEPLOYMENT_MODE=single_user_private

# loopback = local process (frontend talks directly to the same-machine API)
# compose_private = compose mode (API listens only on the private network)
API_BIND_SCOPE=loopback

# Local process: loopback API URL. Compose profile overrides to http://api:8000.
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# Non-empty actor identity. The client cannot override this value.
ACTOR_ID=local-actor

# ---- Database ----
# Local process uses locally installed PostgreSQL.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/novel

# ---- LLM ----
LLM_BASE_URL=
LLM_API_KEY=
MODEL_NAME=
DEFAULT_TOKEN_BUDGET=8192

# ---- Retention (days) ----
AUDIT_RETENTION_DAYS=30
CHECKPOINT_RETENTION_DAYS=7

# ---- Observability (LangSmith) ----
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
# Content capture is only allowed when APP_ENV=development|evaluation.
# Production examples keep content capture off by default.
LANGSMITH_CAPTURE_CONTENT=false